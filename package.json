  "dependencies": {
    "@busch-jaeger/free-at-home": "^0.37.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@busch-jaeger/free-at-home-cli": "^0.13.1",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
