{
  "name": "free-at-home-shelly-switch",
  "version": "2.0.0",
  "description": "free@home Add-On zur Steuerung von Shelly-Schaltaktoren und -Steckdosen",
  "main": "build/main.js",
  "private": true,
  "scripts": {
