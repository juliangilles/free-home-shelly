{
  "version": "2.0.0",
  "id": "de.julian-gilles.shelly-switch",
  "name": {
    "en": "Shelly Switch Actuators",
    "de": "Shelly Schaltaktoren"
  },
  "description": {
    "en": "Control Shelly relays and smart plugs (Gen1 to Gen4) as free@home switch actuators.",
    "de": "Steuert Shelly-Relais und -Steckdosen (Gen1 bis Gen4) als free@home Schaltaktoren."
  },
  "license": "MIT",
  "author": "Julian Gilles",
  "url": "https://github.com/juliangilles/free-home-shelly",
  "entryPoint": "build/main.js",
  "type": "app",
  "accessControl": {
    "networkAccess": true
  },
  "parameters": {
    "shellys": {
      "name": "Shelly devices",
      "name@de": "Shelly-Geräte",
      "multiple": true,
      "items": {
        "name": {
          "name": "Name",
          "name@de": "Name",
          "type": "string",
          "required": true
        },
        "ip": {
          "name": "IP address",
          "name@de": "IP-Adresse",
          "type": "ipv4",
          "required": true
        }
      }
    }
  },
  "supportUrl": "https://github.com/juliangilles/free-home-shelly/issues"
}
